---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
}

const SITE_NAME = 'Thomas Greco';
const {
  title,
  description = 'Thomas Greco writes about TypeScript, functional programming, and the things he builds on weekends.',
  canonical,
  image,
  type = 'website',
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const canonicalURL = canonical ?? pageUrl.href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Thomas Greco" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f2efe7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1915" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <title>{path === '/' ? SITE_NAME : `${title} — ${SITE_NAME}`}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <div class="wrap">
      <nav class="nav" aria-label="Site">
        <a class="brand" href="/">tgrecojs.com <span>— Thomas Greco</span></a>
        <div class="pills">
          <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Posts</a>
          <a href="/about" aria-current={isCurrent('/about') ? 'page' : undefined}>About</a>
          <a href="https://hindleymilner.com">HM ↗</a>
        </div>
      </nav>

      <main>
        <slot />
      </main>

      <footer class="footer">
        <span>© {new Date().getFullYear()} Thomas Greco</span>
        <span>
          <a href="/rss.xml">RSS</a> · <a href="https://github.com/tgrecojs">GitHub</a> ·
          <a href="https://hindleymilner.com">Hindley Milner Systems</a>
        </span>
      </footer>
    </div>

    {
      import.meta.env.PROD && (
        <script is:inline>
          if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
          }
        </script>
      )
    }
  </body>
</html>
