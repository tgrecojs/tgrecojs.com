---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import ThemeScript from '../components/ThemeScript.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Webring from '../components/Webring.astro';
import { site } from '../site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  type?: 'website' | 'article';
}

const SITE_NAME = site.author;
const {
  title,
  description = site.description,
  canonical,
  // Every page gets a large card: posts pass their own, everything else uses the site card.
  image = '/og/home.png',
  imageAlt = title,
  imageWidth = 1200,
  imageHeight = 630,
  imageType = 'image/png',
  type = 'website',
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const canonicalURL = canonical ?? pageUrl.href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <ThemeScript />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Thomas Greco" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,600;1,500&family=IBM+Plex+Sans:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{path === '/' ? SITE_NAME : `${title} — ${SITE_NAME}`}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:type" content={imageType} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site).href} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:creator" content={site.handle} />
    <slot name="head" />
    <Analytics />
    {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id="32249bbe-294f-4fce-9839-c0b8f1588bea"
        data-domains="tgrecojs.com,www.tgrecojs.com"
      ></script>
    )}
  </head>
  <body>
    <div class="wrap">
      <header class="nav">
        <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>tgrecojs.com <span>— Thomas Greco</span></a>
        <ThemeToggle />
      </header>

      <main>
        <slot />
      </main>

      <footer class="footer">
        <Webring />
        <div class="footer-row">
          <span>© {new Date().getFullYear()} {site.author}</span>
          <nav class="footer-nav" aria-label="Elsewhere">
            {site.links.map((l) => (
              <a href={l.href} rel={'rel' in l ? l.rel : undefined}>{l.label}</a>
            ))}
          </nav>
        </div>
      </footer>
    </div>

    {
      import.meta.env.PROD && (
        <script is:inline>
          if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
          }
        </script>
      )
    }
    <SpeedInsights />
  </body>
</html>
