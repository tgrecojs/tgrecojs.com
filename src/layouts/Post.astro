---
import Base from './Base.astro';
import Figure from '../components/Figure.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, series, seriesOrder, minutesRead, figure } =
  post.data;

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title={title} description={description} type="article">
  <article class="post">
    <header class="post-header">
      <div class="meta mono">
        <i class="dot dot-here" aria-hidden="true"></i>
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {updatedDate && <span>updated {fmt(updatedDate)}</span>}
        {minutesRead ? <span>{minutesRead} min</span> : null}
        {series && (
          <span>
            {series}{seriesOrder && `, part ${seriesOrder}`}
          </span>
        )}
      </div>
      <h1 class="post-title">{title}</h1>
      <p class="post-desc">{description}</p>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <a href={`/tags/${tag}`} class="tag">{tag}</a>
          ))}
        </div>
      )}
    </header>

    {figure && <Figure src={figure} title={title} />}

    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .post-header { margin-top: 3.5rem; padding-bottom: 1.5rem; border-bottom: 1.5px solid var(--ink); }
  .meta { display: flex; gap: .9rem; align-items: center; flex-wrap: wrap; }
  .post-title {
    font-family: var(--f-display); font-weight: 600; font-optical-sizing: auto;
    font-size: clamp(1.9rem, 5.5vw, 2.75rem); line-height: 1.08; letter-spacing: -.015em;
    margin: .6rem 0 .8rem; text-wrap: balance;
  }
  .post-desc { margin: 0 0 1rem; color: var(--ink-2); font-size: 1.15rem; max-width: 36rem; }
  .prose { margin-top: 2.5rem; }
</style>
