---
import Base from './Base.astro';
import Figure from '../components/Figure.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, source, canonical, series, seriesOrder, minutesRead, figure } =
  post.data;

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' });
const mirrored = source === 'hindleymilner';
---

<Base title={title} description={description} canonical={canonical} type="article">
  <article class="post">
    <header class="post-header">
      <div class="meta mono">
        <i class:list={['dot', mirrored ? 'dot-hm' : 'dot-here']} aria-hidden="true"></i>
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {updatedDate && <span>updated {fmt(updatedDate)}</span>}
        {minutesRead && <span>{minutesRead} min</span>}
        {series && (
          <span>
            {series}{seriesOrder && `, part ${seriesOrder}`}
          </span>
        )}
      </div>
      <h1 class="post-title">{title}</h1>
      <p class="post-desc">{description}</p>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <a href={`/tags/${tag}`} class="tag">{tag}</a>
          ))}
        </div>
      )}
    </header>

    {
      mirrored && canonical && (
        <aside class="mirror mono">
          <i class="dot dot-hm" aria-hidden="true"></i>
          <span>
            First published at <a href={canonical}>hindleymilner.com</a>, mirrored here.
          </span>
        </aside>
      )
    }

    {figure && <Figure src={figure} title={title} />}

    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .post-header { margin-top: 3.5rem; padding-bottom: 1.5rem; border-bottom: 1.5px solid var(--ink); }
  .meta { display: flex; gap: .9rem; align-items: center; flex-wrap: wrap; }
  .post-title {
    font-family: var(--f-display); font-weight: 700; font-variation-settings: "opsz" 144;
    font-size: clamp(2rem, 6vw, 3rem); line-height: 1.05; letter-spacing: -.02em;
    margin: .6rem 0 .8rem; text-wrap: balance;
  }
  .post-desc { margin: 0 0 1rem; color: var(--ink-2); font-size: 1.15rem; max-width: 36rem; }
  .mirror { display: flex; gap: .6rem; align-items: center; margin-top: 1.25rem; color: var(--ink-2); }
  .mirror a { color: var(--ink); }
  .prose { margin-top: 2.5rem; }
</style>
