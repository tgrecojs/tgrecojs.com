---
import Base from './Base.astro';
import Figure from '../components/Figure.astro';
import PostFooter from '../components/PostFooter.astro';
import { formatDate, getPosts, minutesRead, postDot, type Post } from '../lib/posts';
import { site } from '../site';

interface Props {
  post: Post;
  /** From render(post). The h2s become the contents list beside the post on wide screens. */
  headings?: { depth: number; slug: string; text: string }[];
}

const { post, headings = [] } = Astro.props;
const contents = headings.filter((h) => h.depth === 2);
const { title, description, pubDate, updatedDate, tags, series, seriesOrder, figure } = post.data;

// The published list, newest first: it decides this post's dot colour and its neighbours.
const posts = await getPosts();
const url = new URL(`/posts/${post.id}`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { '@type': 'Person', name: site.author, url: Astro.site?.href },
  image: new URL(`/og/${post.id}.png`, Astro.site).href,
  url,
  keywords: tags.join(', '),
};
---

<Base
  title={title}
  description={description}
  type="article"
  image={`/og/${post.id}.png`}
  imageAlt={`${title}, by ${site.author}`}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <meta property="article:author" content={site.author} />
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article class="post" data-minutes={minutesRead(post)}>
    <header class="post-header">
      <div class="meta mono">
        <i class={`dot ${postDot(post, posts)}`} aria-hidden="true"></i>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span>updated {formatDate(updatedDate)}</span>}
        <span>{minutesRead(post)} min</span>
        {series && (
          <span>
            {series}{seriesOrder && `, part ${seriesOrder}`}
          </span>
        )}
      </div>
      <h1 class="post-title">{title}</h1>
      <p class="post-desc">{description}</p>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <a href={`/tags/${tag}`} class="tag">{tag}</a>
          ))}
        </div>
      )}
    </header>

    {figure && <Figure src={figure} title={title} />}

    {contents.length > 1 && (
      <nav class="contents" aria-labelledby="contents-heading">
        <h2 id="contents-heading" class="mono">On this page</h2>
        <ol>
          {contents.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose">
      <slot />
    </div>

    <PostFooter post={post} posts={posts} url={url} />
  </article>
</Base>

<style>
  .post-header { margin-top: 3.5rem; padding-bottom: 1.5rem; border-bottom: 1.5px solid var(--ink); }
  .meta { display: flex; gap: .25rem .9rem; align-items: center; flex-wrap: wrap; }
  .post-title {
    font-family: var(--f-display); font-weight: 600; font-optical-sizing: auto;
    font-size: clamp(var(--fs-5), 5.5vw, var(--fs-6)); line-height: 1.08; letter-spacing: -.015em;
    margin: .6rem 0 .8rem; text-wrap: balance;
  }
  .post-desc { margin: 0 0 1rem; color: var(--ink-2); font-size: var(--fs-4); line-height: 1.4; max-width: var(--text); text-wrap: pretty; }
  .prose { margin-top: 2.5rem; }

  /* The contents list only has somewhere to live once the aside track exists. */
  .contents { display: none; }

  /* From 60rem the meta line moves into the rail and sits on the title's first baseline.
     Everything else is on the text column; only the title may run past it. */
  @media (min-width: 60rem) {
    .post, .post-header { display: grid; grid-template-columns: var(--rail) minmax(0, 1fr); column-gap: var(--gutter); }
    .post > :global(*) { grid-column: 2; }
    .post > .post-header { grid-column: 1 / -1; align-items: baseline; }
    .post-header > * { grid-column: 2; }
    .post-header > .meta { grid-column: 1; grid-row: 1 / span 3; align-items: baseline; }
    .post-header > .post-title { grid-column: 2 / -1; margin-top: 0; }
  }
  /* From 80rem the contents list takes the aside and stays in view beside the prose. */
  @media (min-width: 80rem) {
    .post, .post-header { grid-template-columns: var(--rail) minmax(0, var(--text)) minmax(0, 1fr); }
    .post > .post-header { grid-row: 1; }
    .post > :global(.figure) { grid-row: 2; }
    .post > .prose { grid-row: 3; }
    .post > :global(.post-end) { grid-row: 4; }
    .post > .contents { display: block; grid-column: 3; grid-row: 2 / span 2; align-self: start; position: sticky; top: 1.5rem; margin-top: 2.5rem; }
    .contents h2 { margin: 0 0 .6rem; letter-spacing: .08em; text-transform: uppercase; }
    /* The list hangs off a hairline rail. The marker on the rail is a 1px box that the
       script below moves and stretches with --y and --h, so only transform animates. */
    .contents ol { position: relative; list-style: none; margin: 0; padding: 0 0 0 .9rem; border-left: 1px solid var(--rule); }
    .contents ol::before {
      content: ''; position: absolute; left: -1.5px; top: 0; width: 2px; height: 1px; background: var(--accent);
      transform-origin: top; transform: translateY(var(--y, 0px)) scaleY(var(--h, 0));
      transition: transform .2s cubic-bezier(.2, 0, 0, 1);
    }
    .contents a { display: block; padding-block: .3rem; color: var(--ink-2); font-size: var(--fs-1); line-height: 1.35; text-decoration: none; text-wrap: balance; }
    .contents a:hover { color: var(--ink); text-decoration: underline; }
    /* A hairline stroke reads as bold without changing the text's width, so nothing rewraps. */
    .contents a[data-active] { color: var(--ink); -webkit-text-stroke: .3px currentColor; }
  }
  @media (prefers-reduced-motion: reduce) { .contents ol::before { transition: none; } }
</style>

<script>
  import { track as sendEvent } from '../lib/track';

  // Marks the contents links whose sections are on screen, and stretches the rail marker
  // over them. A section runs from its h2 to the next h2, or to the end of the prose.
  const list = document.querySelector<HTMLElement>('.contents ol');
  const prose = document.querySelector('.prose');
  if (list && prose) {
    const links = [...list.querySelectorAll('a')];
    const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))!);
    // A section counts once this much of it shows. 48px is just over the gap above an h2,
    // so a section whose last visible part is that gap no longer counts.
    const EDGE = 48;
    const track = () => {
      const tops = [...heads.map((h) => h.getBoundingClientRect().top), prose.getBoundingClientRect().bottom];
      const on = links.filter((_, i) => tops[i] < innerHeight - EDGE && tops[i + 1] > EDGE);
      links.forEach((a) => {
        a.toggleAttribute('data-active', on.includes(a));
        // Only one link may be "current": the section at the top of the screen.
        if (a === on[0]) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
      const first = on[0];
      const last = on[on.length - 1];
      // With nothing on screen the marker keeps its place and closes to nothing.
      if (first) list.style.setProperty('--y', `${first.offsetTop}px`);
      list.style.setProperty('--h', first ? `${last.offsetTop + last.offsetHeight - first.offsetTop}` : '0');
    };
    addEventListener('scroll', track, { passive: true });
    addEventListener('resize', track);
    track();
  }

  // Sends "read-to-end" to Umami once the post's ending is on screen and the reader has had
  // the page open for a quarter of the estimated reading time. The wait keeps a quick scroll
  // to the footer from counting as a read.
  const article = document.querySelector<HTMLElement>('.post');
  const ending = document.querySelector('.post-end');
  if (article && ending) {
    const due = (Number(article.dataset.minutes) * 60_000) / 4;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const reached = new IntersectionObserver(([entry]) => {
      clearTimeout(timer);
      if (!entry.isIntersecting) return;
      timer = setTimeout(() => {
        sendEvent('read-to-end');
        reached.disconnect();
      }, Math.max(0, due - performance.now()));
    });
    reached.observe(ending);
  }
</script>
