---
// The post index on the home page and on each tag page: one row per post. The dot colour
// comes from a row's slot in the list it is shown in (see dotClass in src/lib/posts.ts).
import { dotClass, formatDate, minutesRead, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<ul class="posts">
  {
    posts.map((post, i) => (
      <li class="post">
        <i class={`dot ${dotClass(i)}`} aria-hidden="true" />
        <div class="post-body">
          <div class="meta mono">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <span>{minutesRead(post)} min</span>
            {post.data.draft && <span class="draft">draft</span>}
          </div>
          <h2>
            <a href={`/posts/${post.id}`}>{post.data.title}</a>
          </h2>
          <p>{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.map((tag) => (
                <a href={`/tags/${tag}`} class="tag">{tag}</a>
              ))}
            </div>
          )}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .posts { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.25rem; }
  .post { display: grid; grid-template-columns: 14px minmax(0, 1fr); gap: 0 1rem; align-items: start; }
  .post > .dot { margin-top: .55rem; }
  .meta { display: flex; gap: .25rem .9rem; flex-wrap: wrap; }
  .meta .draft { color: var(--draft); }
  h2 { font-family: var(--f-display); font-optical-sizing: auto; font-weight: 600; font-size: var(--fs-4); line-height: 1.2; letter-spacing: -.01em; margin: .25rem 0 .4rem; text-wrap: balance; }
  h2 a { color: var(--ink); text-decoration: none; background-image: linear-gradient(var(--accent), var(--accent)); background-size: 0 2px; background-repeat: no-repeat; background-position: 0 100%; transition: background-size .18s cubic-bezier(.2, 0, 0, 1); }
  h2 a:hover { background-size: 100% 2px; }
  p { margin: 0 0 .6rem; color: var(--ink-2); font-size: var(--fs-2); text-wrap: pretty; }

  /* Wide: the same tracks as a post. The dot and date sit in the rail on the title's
     baseline; the title and summary take the text column. */
  @media (min-width: 60rem) {
    .post { grid-template-columns: var(--rail) minmax(0, var(--text)); column-gap: var(--gutter); align-items: baseline; }
    .post-body { display: contents; }
    .post > .dot { grid-area: 1 / 1; justify-self: start; margin-top: 0; }
    .meta { grid-area: 1 / 1 / span 3; padding-inline-start: calc(14px + .75rem); }
    h2, p, .tags { grid-column: 2; }
    h2 { margin-top: 0; }
  }
  /* Widest: tags move out to the space on the right, level with the title. */
  @media (min-width: 80rem) {
    .post { grid-template-columns: var(--rail) minmax(0, var(--text)) minmax(0, 1fr); }
    .tags { grid-area: 1 / 3 / span 3; }
  }
  @media (prefers-reduced-motion: reduce) { h2 a { transition: none; } }
</style>
