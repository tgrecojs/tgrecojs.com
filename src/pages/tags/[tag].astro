---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft);
  const tags = new Set(posts.flatMap((p) => p.data.tags));
  return [...tags].map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`Tagged “${tag}”`} description={`Posts tagged ${tag}.`}>
  <header class="head">
    <p class="mono"><a href="/tags">All tags</a></p>
    <h1>{tag}</h1>
  </header>
  <PostList posts={posts} />
</Base>

<style>
  .head { margin: 3.5rem 0 1.75rem; padding-bottom: 1rem; border-bottom: 1.5px solid var(--ink); }
  .head p { margin: 0 0 .5rem; }
  h1 { font-family: var(--f-mono); font-weight: 600; font-size: var(--fs-5); margin: 0; }
</style>
