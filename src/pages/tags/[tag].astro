---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft);
  const tags = new Set(posts.flatMap((p) => p.data.tags));
  return [...tags].map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title={`Tagged “${tag}”`} description={`Posts tagged ${tag}.`}>
  <header class="head">
    <p class="mono"><a href="/tags">All tags</a></p>
    <h1>{tag}</h1>
  </header>
  <ul class="posts">
    {
      posts.map((post) => (
        <li>
          <div class="meta mono">
            <i class="dot dot-here" aria-hidden="true" />
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          </div>
          <h2><a href={`/posts/${post.id}`}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .head { margin-top: 3.5rem; padding-bottom: 1rem; border-bottom: 1.5px solid var(--ink); }
  .head p { margin: 0 0 .5rem; }
  h1 { font-family: var(--f-mono); font-weight: 600; font-size: 1.6rem; margin: 0; }
  .posts { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 2rem; }
  .meta { display: flex; gap: .6rem; align-items: center; }
  .posts h2 { font-family: var(--f-display); font-optical-sizing: auto; font-weight: 600; font-size: 1.45rem; line-height: 1.2; margin: .25rem 0 .3rem; }
  .posts h2 a { color: var(--ink); text-decoration: none; }
  .posts h2 a:hover { text-decoration: underline; }
  .posts p { margin: 0; color: var(--ink-2); max-width: 36rem; }
</style>
