---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft);
const counts = new Map<string, number>();
for (const post of posts) for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Base title="Tags" description="Every tag used on tgrecojs.com.">
  <header class="head">
    <h1>Tags</h1>
  </header>
  <ul class="list">
    {
      tags.map(([tag, n]) => (
        <li>
          <a href={`/tags/${tag}`} class="tag">{tag}</a>
          <span class="mono">{n}</span>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .head { margin-top: 3.5rem; padding-bottom: 1rem; border-bottom: 1.5px solid var(--ink); }
  h1 { font-family: var(--f-display); font-weight: 600; font-optical-sizing: auto; font-size: 2.2rem; margin: 0; letter-spacing: -.015em; }
  .list { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; }
  .list li { display: inline-flex; align-items: center; gap: .4rem; }
</style>
