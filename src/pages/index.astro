---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

// Drafts show in `astro dev`, never in the build.
const posts = await getPosts();

// The plate on the home page links to the telescope post once it is published.
const telescope = posts.find((p) => p.id === 'telescope');
---

<Base title="Thomas Greco">
  <header class="hero">
    <div>
      <h1>Footprints in the sand from <em>Thomas Greco</em></h1>
      <p>
       Trials and tribulations of a programmer with a deep appreciation for deterministic software... and also, life!
      </p>
    </div>
    <figure class="plate">
      {
        telescope ? (
          <a href={`/posts/${telescope.id}`} aria-label="Read the telescope post">
            <img src="/img/telescope-figure.jpg" width="640" height="820" alt="Hand-inked isometric drawing of an 80 mm refractor telescope on a tripod, with a flat blue cast shadow" />
          </a>
        ) : (
          <img src="/img/telescope-figure.jpg" width="640" height="820" alt="Hand-inked isometric drawing of an 80 mm refractor telescope on a tripod, with a flat blue cast shadow" />
        )
      }
      <figcaption class="figcap"><b>Fig. 21</b> — Telescope, 80 mm f/10 on an EQ2 mount</figcaption>
    </figure>
  </header>

  {posts.length === 0 && <p class="mono">Nothing published yet.</p>}

  <PostList posts={posts} />
</Base>

<style>
  /* The rule under the hero opens the post list. */
  .hero { display: grid; grid-template-columns: 1fr minmax(180px, 240px); gap: 1.5rem var(--gutter); align-items: end; margin: 3.5rem 0 1.75rem; padding-bottom: 3rem; border-bottom: 1.5px solid var(--ink); }
  .hero h1 {
    font-family: var(--f-display); font-weight: 600; font-optical-sizing: auto;
    font-size: clamp(var(--fs-5), 6.5vw + .5rem, var(--fs-7)); line-height: 1.04; letter-spacing: -.015em; margin: 0 0 1rem; text-wrap: balance;
  }
  .hero h1 em { font-style: italic; font-weight: 500; }
  .hero p { margin: 0; max-width: 34rem; color: var(--ink-2); }
  .plate { margin: 0; }
  .plate a { display: block; }
  .plate img { display: block; width: 100%; height: auto; border: 1.5px solid var(--ink); box-shadow: 3px 3px 0 var(--shadow); background: #f2efe7; transition: transform .12s ease, box-shadow .12s ease; }
  .plate a:hover img { transform: translate(1px, 1px); box-shadow: 2px 2px 0 var(--shadow); }

  /* Widest: the plate takes the same right-hand track as the tags in the list below. */
  @media (min-width: 80rem) { .hero { grid-template-columns: minmax(0, 1fr) var(--aside); } }
  @media (max-width: 600px) {
    .hero { grid-template-columns: 1fr; align-items: start; margin-top: 2.5rem; }
    .plate { max-width: 200px; order: -1; }
  }
  @media (prefers-reduced-motion: reduce) { .plate img { transition: none; } }
</style>
