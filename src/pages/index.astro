---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Drafts show in `astro dev`, never in the build.
const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' });

// The plate on the home page links to the telescope post once it is published.
const telescope = posts.find((p) => p.id === 'telescope');
---

<Base title="Thomas Greco">
  <header class="hero">
    <div>
      <h1>Notes from <em>Thomas Greco</em></h1>
      <p>
        Software engineer. TypeScript, functional programming, and the things I build on weekends. Some posts first
        appear at <a href="https://hindleymilner.com">Hindley Milner Systems</a> and are mirrored here; the rest are
        mine alone.
      </p>
    </div>
    <figure class="plate">
      {
        telescope ? (
          <a href={`/posts/${telescope.id}`} aria-label="Read the telescope post">
            <img src="/img/telescope-figure.jpg" width="640" height="820" alt="Hand-inked isometric drawing of an 80 mm refractor telescope on a tripod, with a flat blue cast shadow" />
          </a>
        ) : (
          <img src="/img/telescope-figure.jpg" width="640" height="820" alt="Hand-inked isometric drawing of an 80 mm refractor telescope on a tripod, with a flat blue cast shadow" />
        )
      }
      <figcaption class="figcap"><b>Fig. 21</b> — Telescope, 80 mm f/10 on an EQ2 mount</figcaption>
    </figure>
  </header>

  <div class="legend" aria-label="How posts are marked">
    <span class="lab">Key</span>
    <span class="key"><i class="dot dot-here"></i> written here</span>
    <span class="key"><i class="dot dot-hm"></i> mirrored from hindleymilner.com</span>
  </div>

  {posts.length === 0 && <p class="mono">Nothing published yet.</p>}

  <ul class="posts">
    {
      posts.map((post) => {
        const mirrored = post.data.source === 'hindleymilner';
        return (
          <li class="post">
            <i class:list={['dot', mirrored ? 'dot-hm' : 'dot-here']} title={mirrored ? 'Mirrored from hindleymilner.com' : 'Written here'} />
            <div>
              <div class="meta mono">
                <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                <span class="src">{mirrored ? 'λ hindleymilner.com' : 'tgrecojs.com'}</span>
                {post.data.minutesRead && <span>{post.data.minutesRead} min</span>}
                {post.data.draft && <span class="draft">draft</span>}
              </div>
              <h2>
                <a href={`/posts/${post.id}`}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="tags">
                  {post.data.tags.map((tag) => (
                    <a href={`/tags/${tag}`} class="tag">{tag}</a>
                  ))}
                </div>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1fr minmax(180px, 240px); gap: 1.5rem 2.5rem; align-items: end; margin-top: 3.5rem; }
  .hero h1 {
    font-family: var(--f-display); font-weight: 700; font-variation-settings: "opsz" 144;
    font-size: clamp(2.4rem, 7vw, 3.6rem); line-height: 1.02; letter-spacing: -.02em; margin: 0 0 1rem; text-wrap: balance;
  }
  .hero h1 em { font-style: italic; font-weight: 500; }
  .hero p { margin: 0; max-width: 34rem; color: var(--ink-2); }
  .hero p a { color: var(--ink); }
  .plate { margin: 0; }
  .plate a { display: block; }
  .plate img { display: block; width: 100%; height: auto; border: 1.5px solid var(--ink); box-shadow: 3px 3px 0 var(--shadow); background: #f2efe7; transition: transform .12s ease, box-shadow .12s ease; }
  .plate a:hover img { transform: translate(1px, 1px); box-shadow: 2px 2px 0 var(--shadow); }

  .legend { display: flex; gap: 1.25rem; flex-wrap: wrap; align-items: center; margin-top: 3rem; padding-top: 1.25rem; border-top: 1.5px solid var(--ink); }
  .legend .lab { font: 500 0.7rem/1 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
  .key { display: inline-flex; align-items: center; gap: .45rem; font: 500 .8rem/1 var(--f-mono); color: var(--ink-2); }

  .posts { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; gap: 2.25rem; }
  .post { display: grid; grid-template-columns: 14px 1fr; gap: 0 1rem; align-items: start; }
  .post > .dot { margin-top: .55rem; }
  .meta { display: flex; gap: .9rem; flex-wrap: wrap; }
  .meta .src { color: var(--ink-2); }
  .meta .draft { color: var(--tomato); }
  .post h2 { font-family: var(--f-display); font-variation-settings: "opsz" 48; font-weight: 600; font-size: 1.55rem; line-height: 1.2; letter-spacing: -.01em; margin: .25rem 0 .4rem; text-wrap: balance; }
  .post h2 a { color: var(--ink); text-decoration: none; background-image: linear-gradient(var(--shadow), var(--shadow)); background-size: 0 2px; background-repeat: no-repeat; background-position: 0 100%; transition: background-size .18s ease; }
  .post h2 a:hover { background-size: 100% 2px; }
  .post p { margin: 0 0 .6rem; color: var(--ink-2); max-width: 36rem; }

  @media (max-width: 600px) {
    .hero { grid-template-columns: 1fr; align-items: start; margin-top: 2.5rem; }
    .plate { max-width: 200px; order: -1; }
  }
  @media (prefers-reduced-motion: reduce) { .post h2 a, .plate img { transition: none; } }
</style>
